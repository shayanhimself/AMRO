<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        The device tests run MockWebServer on the device's own loopback and serve plain HTTP,
        which the platform blocks by default. This file is in src/debug, so the permission is not
        merged into a release build at all.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
